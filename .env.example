# Copy to .env and fill in. None of these are required for the local core / examples.

# Optional retrieval / MCP server API keys (only needed once you wire up real servers)
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_MAILTO=
ARXIV_USER_AGENT=

# Optional heavy-tool binary overrides (otherwise discovered on PATH)
SAGE_BIN=
GAP_BIN=
PARI_BIN=
Z3_BIN=
LEAN_BIN=

# Default wall-clock timeout (seconds) for candidate sandbox execution
MH_DEFAULT_TIMEOUT=30
